# SPDX-License-Identifier: AGPL-3.0-or-later
# Settings for the kisiauthong server, all optional. Example values only.

# Address and port to listen on. 127.0.0.1 (the default) serves this machine
# only; 0.0.0.0 serves other devices too (the Docker image sets it).
KISIAUTHONG_HOST=127.0.0.1
PORT=8080

# SQLite database file. Default: data/kisiauthong.db in the working directory
# for release builds (/data/kisiauthong.db in Docker).
KISIAUTHONG_DB=data/kisiauthong.db

# The public address when behind an HTTPS reverse proxy; passkeys need it.
KISIAUTHONG_ORIGIN=https://books.example.com

# Serve the app under a path prefix when a reverse proxy hosts several apps
# on one name, e.g. https://example.org/kisiauthong/ (proxy the prefix as is).
# KISIAUTHONG_BASE_PATH=/kisiauthong

# Serve the web UI from this folder instead of the one built into the binary.
# KISIAUTHONG_WEB=web

# Link to the source of the version you run (AGPL-3.0 §13). Set it if you
# modify the server; it defaults to the upstream repository.
# KISIAUTHONG_SOURCE_URL=https://example.com/my-fork

# "Today" for users whose Settings time zone is Auto: what is scheduled (dated
# after today), budgets, due templates. Falls back to the process zone (TZ).
KISIAUTHONG_TZ=Asia/Taipei
TZ=Asia/Taipei
